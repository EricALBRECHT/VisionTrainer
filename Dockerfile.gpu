# Vision Trainer — NVIDIA GPU / CUDA image
#
# Base: official PyTorch runtime with CUDA 12.4 + cuDNN 9 (Python 3.11).
# Compatible with Ultralytics YOLO and recent NVIDIA drivers via NVIDIA Container Toolkit.
#
# Does NOT replace the CPU image (Dockerfile). Use docker-compose.gpu.yml to launch.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VISIONTRAINER_DATA_DIR=/app/data \
    YOLO_CONFIG_DIR=/app/data/ultralytics \
    TMPDIR=/app/data/tmp \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# OpenCV / video runtime libs (same as CPU image).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

# Install app dependencies while keeping the image CUDA PyTorch stack.
# Ultralytics may pull transitive deps; we re-assert torch CUDA afterwards.
RUN pip install --upgrade pip \
    && pip install --no-cache-dir \
        "streamlit>=1.28.0" \
        "pyyaml>=6.0" \
        "pillow>=10.0.0" \
        "imageio-ffmpeg>=0.5.0" \
        "ultralytics>=8.3.0" \
    && pip install --no-cache-dir --no-deps . \
    && python -c "import torch; assert torch.cuda.is_available() or True; print('torch', torch.__version__, 'cuda_build', torch.version.cuda)"

COPY app ./app
COPY .streamlit ./.streamlit

RUN mkdir -p /app/data/datasets /app/data/runs /app/data/ultralytics /app/data/tmp

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)"

CMD ["streamlit", "run", "app/streamlit_app.py", \
     "--server.address=0.0.0.0", \
     "--server.port=8501", \
     "--server.headless=true", \
     "--browser.gatherUsageStats=false"]
